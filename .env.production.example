# ==============================================================================
# BuildSmart 360 - Production Environment Configuration Template for Render
# ==============================================================================
# Fill in these values in your Render Dashboard under:
# Service -> Environment -> Environment Variables
# ==============================================================================

# Core Runtime Settings
BUILDSMART_MODE=production
HOST=0.0.0.0
PORT=10000

# Google Sheets & Drive Integration
BUILDSMART_SHEET_ID=1Jb1Ht0fxR3eQUj6Rwk3N6_8hIvsTdRzMe-AGacbQYvI
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# Pre-authorized Google OAuth Refresh Token (Enables instant Google connection on boot)
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Registered Google OAuth Redirect URI
# Set this to your live Render HTTPS URL ending in /setup/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://<your-render-service-name>.onrender.com/setup/google/callback

# Brevo Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=vitabsquare@gmail.com
BREVO_SENDER_NAME="BuildSmart 360"

# Initial Administrator Account (Created automatically on first boot)
BUILDSMART_ADMIN_EMAIL=vitabsquare@gmail.com
BUILDSMART_ADMIN_PASSWORD=SetAStrongPassword123!
BUILDSMART_ADMIN_NAME="Vtab Square Admin"

# Initial Builder Account (Optional - Created automatically on first boot)
BUILDSMART_BUILDER_EMAIL=vigneshrajas.vtab@gmail.com
BUILDSMART_BUILDER_PASSWORD=SetAStrongPassword123!
BUILDSMART_BUILDER_NAME="Vtab square"
BUILDSMART_BUILDER_CITY="Coimbatore"

# Allowed CORS Origins (Include your live Render domain)
CORS_ALLOWED_ORIGINS=https://<your-render-service-name>.onrender.com
