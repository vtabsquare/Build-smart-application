# BuildSmart settings
# Replace the PASTE_... values only for the services you use.
# Lines starting with # are comments.

# Google Sheets and Drive
GOOGLE_OAUTH_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID_HERE
GOOGLE_OAUTH_CLIENT_SECRET=PASTE_GOOGLE_CLIENT_SECRET_HERE
# Local default: http://127.0.0.1:5000/setup/google/callback
# For hosted production, enter the registered HTTPS callback here.
GOOGLE_OAUTH_REDIRECT_URI=

# Brevo email
BREVO_API_KEY=PASTE_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=PASTE_VERIFIED_SENDER_EMAIL_HERE
BREVO_SENDER_NAME="BuildSmart 360"
# Legacy sender variable, used when BREVO_SENDER_EMAIL is unset.
BREVO_MAIL=

# Optional AI recommendations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Advanced deployment settings
BUILDSMART_DATA_DIR=
BUILDSMART_SETUP_TOKEN=
BUILDSMART_SHEET_ID=
BUILDSMART_SHEET_ACCESS=service_account
BUILDSMART_SHEETS_CONFIG=
GOOGLE_APPLICATION_CREDENTIALS=
BUILDSMART_ADMIN_EMAIL=
BUILDSMART_ADMIN_PASSWORD=
BUILDSMART_ADMIN_NAME=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
